# Graphable environment variables. Copy to .env (git-ignored) and edit:  cp .env.example .env
# The Python code loads .env at startup (graphable/settings.py); variables already set in the shell win.
# docker compose also reads .env for the ${...} values in docker-compose.yml.
# Put comments on their own line: the .env loader does not strip inline comments.
# Commented-out lines show the default the code uses when the variable is unset.

# ---------------------------------------------------------------- Gemini (optional)
# Google Gemini API key. Empty = deterministic offline mode (no LLM, no embeddings). GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=
# Model for the Investigator's review of the root-cause ranking.
# GEMINI_MODEL_PRO=gemini-pro-latest
# Model for knowledge extraction from prose and for grounded Brain answers.
# GEMINI_MODEL_FLASH=gemini-3.8-flash
# Model for rendering the synthetic dataset's prose (python -m datagen --render gemini).
# GEMINI_MODEL_RENDER=gemini-3.5-flash-lite
# Embedding model for the FalkorDB vector indexes.
# EMBED_MODEL=gemini-embedding-2
# Embedding size; the vector indexes are created with this dimension.
# EMBED_DIM=768
# Knowledge extractor: "gemini" uses Gemini when a key is set; any other value (e.g. "rules") forces the rules extractor.
# EXTRACTOR=gemini

# ---------------------------------------------------------------- FalkorDB
# Host the Python processes connect to (docker compose sets "falkordb" inside the containers).
FALKORDB_HOST=localhost
# Port the Python processes connect to. docker compose also uses it as the host port for FalkorDB.
FALKORDB_PORT=6379
# Credentials, only if your FalkorDB instance requires them (e.g. FalkorDB Cloud). Empty = no auth.
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# Default per-query timeout in ms (must not exceed the server's TIMEOUT_MAX).
# QUERY_TIMEOUT_MS=8000

# ---------------------------------------------------------------- Tenants and paths
# API keys / MCP bearer tokens and the tenant each one maps to, as key:tenant pairs. Change these outside local dev.
# TENANT_KEYS=dev-acme:acme,dev-globex:globex,dev-demo:demo_main
# Folder with the generated dataset (default: datagen/out in the repo).
# DATA_DIR=./datagen/out

# ---------------------------------------------------------------- MCP server
# URL the API's agents use to reach the MCP server (docker compose sets http://mcp:8765/mcp).
# MCP_URL=http://127.0.0.1:8765/mcp
# Host headers the MCP server accepts (DNS-rebinding protection), comma-separated host:port patterns.
# MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,[::1]:*,mcp:*
# Dev/eval only: 1 lets the MCP server accept "eval:<tenant>" bearer tokens for scratch tenants named eval_* or demo_*.
# Needed by "python -m graphable.evals.system --bus mcp". Never set it on a shared or public server.
# GRAPHABLE_ALLOW_EVAL_TOKENS=1
# Only for the MCP server over stdio (no HTTP request, so no bearer token): the tenant to use.
# GRAPHABLE_TENANT=acme

# ---------------------------------------------------------------- API
# Tenant used when a request has no X-API-Key header (the web app's demo tenant, a copy of golden_acme).
# DEMO_TENANT=demo_main
# Demo clock in epoch ms: the "now" for Brain answers, entity pages and live ingest (scenario runs use their own clock).
# DEMO_NOW=1791936000000
# How agents call tools: "mcp" (through the MCP server) or "direct" (in-process). Unset = use MCP if MCP_URL answers, else direct.
# BUS_MODE=
# Allowed CORS origins, comma-separated.
# CORS_ORIGINS=*
# Demo tenant only: 1 lets a high-confidence SEV1 with a verified path page on-call without approval (default: every page waits for a human).
# DEMO_AUTO_PAGE=0

# ---------------------------------------------------------------- Hosted mode (render.yaml)
# DUMP of the trimmed demo graph (python -m graphable.deploy_snapshot). When set, reset deletes the demo graph and
# RESTOREs it from this file instead of copying golden_acme, and a database that restarted empty is refilled.
# DEMO_SNAPSHOT=deploy/demo_snapshot.dump
# With DEMO_SNAPSHOT: after this many played scenarios, the next play starts the shared demo graph over.
# DEMO_MAX_PLAYED=30
# 1 = this API process also serves the MCP endpoint at /mcp (one port); set MCP_URL to http://127.0.0.1:<port>/mcp.
# SERVE_MCP=

# ---------------------------------------------------------------- Web app (apps/web)
# API base URL the browser calls. Read at build time (npm run build / docker build).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/v1

# ---------------------------------------------------------------- docker compose host ports (compose only)
# FALKORDB_BROWSER_PORT=3000
# MCP_PORT=8765
# API_PORT=8000
# WEB_PORT=3001
